# ForentisAI environment template. Copy to .env and adjust for local use.
# Never commit real secrets.

# Rspamd scanning endpoint (Step 2/3).
# - Code running on the HOST (API server, tests):   http://127.0.0.1:11333
# - Code running INSIDE the Docker Compose network: http://rspamd:11333
# Port 11333 is the normal worker /checkv2 scanning API.
RSPAMD_URL=http://127.0.0.1:11333

# Scan request timeout in seconds.
RSPAMD_TIMEOUT_SECONDS=30

# API settings (Step 3).
# Comma-separated list of allowed CORS origins for local development.
# Never use "*" together with credentials; add production origins explicitly.
# For the Chrome extension add its origin, e.g. chrome-extension://<extension-id>
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Deployment environment label (local | development | production).
# Any non-local environment requires API keys (fail-closed).
API_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Step 4 - intelligence bounds (DNS/RDAP).
# ---------------------------------------------------------------------------
DNS_INTELLIGENCE_TIMEOUT_SECONDS=3
DNS_INTELLIGENCE_LIFETIME_SECONDS=6
RDAP_INTELLIGENCE_TIMEOUT_SECONDS=10
INTELLIGENCE_MAX_IPS=32
INTELLIGENCE_MAX_DOMAINS=32
INTELLIGENCE_MAX_URLS=64
INTELLIGENCE_PERFORM_DNS=true
INTELLIGENCE_PERFORM_RDAP=true

# ---------------------------------------------------------------------------
# Step 5 - AI/ML threat analysis (see README.md "Configuration" and
# ai/configs/model_config.yaml). Relative model paths resolve against the
# project root; never set machine-specific absolute paths here.
# ---------------------------------------------------------------------------

# Master switch for the AI layer. false -> explicit not_enabled states in
# the ai section of /analyze-email (Step 1-4 evidence is unaffected).
AI_ENABLED=true

# Base directory for model artifacts (default: ai/models).
#AI_MODEL_DIR=ai/models

# Technical (scikit-learn) model artifact. Defaults to
# $AI_MODEL_DIR/technical_model.joblib.
#TECHNICAL_MODEL_PATH=ai/models/technical_model.joblib

# Fine-tuned DeBERTa-v3 email-threat classifier artifact directory (the
# official ForentisAI artifact, trained on ForentisAI_DeBERTa_Dataset_V2).
# Defaults to the local artifact below (resolved against the project root);
# override to point at a different local artifact directory. If the
# directory, its weights, or its forentisai_model.json manifest is
# missing/invalid, the NLP component reports an explicit unavailable state;
# the backend never downloads models at request time.
NLP_MODEL_PATH=ai/models/nlp/forentisai_deberta_v3

# Base model family the production artifact was trained FROM (the base
# model itself is never used for prediction; inference refuses artifacts
# without the official ForentisAI manifest forentisai_model.json).
NLP_MODEL_NAME=microsoft/deberta-v3-base

# Character bound on prepared NLP model input.
AI_MAX_TEXT_LENGTH=6000

# Per-model inference timeout in seconds; a timeout becomes an explicit
# error state, never a benign prediction.
AI_INFERENCE_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Phase 4 - Authentication mode.
# ---------------------------------------------------------------------------

# true (default): Rspamd being unreachable fails the request with a
#   controlled 503 - authentication is mandatory.
# false (degraded mode): an unreachable Rspamd becomes an explicit
#   'unavailable' authentication status and the analysis continues with
#   reduced confidence and an explicit limitation. Never a fabricated pass.
FORENTISAI_AUTH_STRICT=true

# ---------------------------------------------------------------------------
# Phase 6 - Persistence (privacy-first; raw email bodies are NEVER stored).
# ---------------------------------------------------------------------------

# SQLAlchemy URL. SQLite for local development; PostgreSQL in production:
#   postgresql+psycopg://user:pass@host:5432/forentisai
FORENTISAI_DATABASE_URL=sqlite:///./forentisai.db

# Derived-record retention in days (0 = keep indefinitely).
FORENTISAI_RETENTION_DAYS=30

# Master switch for persistence.
FORENTISAI_PERSIST_ENABLED=true

# ---------------------------------------------------------------------------
# Phase 8 - API security.
# ---------------------------------------------------------------------------

# Comma-separated API keys. In 'local' environments with NO keys,
# unauthenticated localhost development use is allowed. Any other
# environment is fail-closed and requires a valid key on /analyze-email and
# /reports (Authorization: Bearer <key> or X-API-Key: <key>).
# Generate with e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never hard-code values anywhere; pass them via the environment only.
#FORENTISAI_API_KEYS=

# In-memory rate limiting (per identity, per window).
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Phase 9 - Docker Compose stack (only used by docker-compose.yml).
# ---------------------------------------------------------------------------

# PostgreSQL credentials for the local stack. The defaults in
# docker-compose.yml are LOCAL DEVELOPMENT ONLY; always override them.
#POSTGRES_USER=forentisai
#POSTGRES_PASSWORD=change-me-local-dev
#POSTGRES_DB=forentisai

# ---------------------------------------------------------------------------
# Phase 12 - Chrome extension / Gmail OAuth (see extension/README.md).
# The extension ID is generated by Chrome when the unpacked extension is
# loaded; add its origin to API_CORS_ORIGINS above (chrome-extension://<id>).
# OAuth client secrets are configured in the extension build, never here.
# ---------------------------------------------------------------------------
